# MEUTE Relay Agent — exemple de configuration
# Copier en `scripts/meute_relay.env` sur la machine cible.
# Ne jamais committer le fichier reel s'il contient des secrets.

MEUTE_PROJECT="PACTE_IA"
MEUTE_OPERATOR="Arnaud"
MEUTE_NODE="raspberry-pi"

# Mode par defaut : aucun envoi automatique aux IA.
# Valeurs prevues : manual, api
MEUTE_SEND_MODE="manual"

# Niveau de securite courant : PACTE-5, PACTE-4, PACTE-3, PACTE-2, PACTE-1
MEUTE_DEFCON="PACTE-5"

# Si true, le script refuse de traiter les paquets marques PACTE-3 ou plus sensible.
MEUTE_PUBLIC_ONLY="true"

# Dossiers
MEUTE_OUTBOX="DISPATCH/OUTBOX"
MEUTE_INBOX="DISPATCH/INBOX"
MEUTE_PROCESSED="DISPATCH/PROCESSED"
MEUTE_SESSIONS="SESSIONS"
MEUTE_ARCHIVE="ARCHIVE"

# Git
MEUTE_GIT_REMOTE="origin"
MEUTE_GIT_BRANCH="main"
MEUTE_AUTO_COMMIT="false"
MEUTE_AUTO_PUSH="false"
